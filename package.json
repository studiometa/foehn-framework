{
  "name": "foehn",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/vite-plugin",
    "packages/starter"
  ],
  "scripts": {
    "lint:editor": "node --check packages/foehn/resources/js/editor.js",
    "test:editor": "node --test \"packages/foehn/tests/js/*.test.mjs\"",
    "fmt": "oxfmt --write README.md .planning/ packages/*/README.md",
    "fmt:check": "oxfmt --check README.md .planning/ packages/*/README.md",
    "docs:dev": "npm run --prefix docs dev",
    "docs:build": "npm run --prefix docs build",
    "docs:preview": "npm run --prefix docs preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0"
  },
  "lint-staged": {
    "*.php": [
      "composer fix --"
    ],
    "*.md": [
      "oxfmt --write"
    ],
    "packages/foehn/resources/js/editor.js": [
      "node --check"
    ]
  },
  "version": "0.2.0"
}
