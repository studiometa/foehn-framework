{
    "name": "studiometa/foehn-monorepo",
    "description": "Foehn monorepo \u2014 development workspace",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/foehn",
            "options": {
                "versions": {
                    "studiometa/foehn": "0.5.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/acf"
        },
        {
            "type": "path",
            "url": "packages/installer"
        },
        {
            "type": "path",
            "url": "packages/starter"
        },
        {
            "type": "path",
            "url": "packages/demo"
        }
    ],
    "require": {
        "studiometa/foehn": "@dev",
        "studiometa/foehn-acf": "@dev",
        "studiometa/foehn-installer": "@dev"
    },
    "require-dev": {
        "carthage-software/mago": "~1.46.0",
        "composer/composer": "^2.10",
        "pestphp/pest": "^5.1",
        "php-stubs/acf-pro-stubs": "^6.8",
        "php-stubs/wordpress-stubs": "*",
        "php-stubs/wp-cli-stubs": "^2.12",
        "stoutlogic/acf-builder": "^1.12",
        "studiometa/ui": "^1.10",
        "studiometa/webpack-config": "^6.4"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "packages/starter/theme/app/",
            "Demo\\": "packages/demo/theme/app/",
            "Studiometa\\Foehn\\Tests\\": "packages/foehn/tests/",
            "Tests\\": ["packages/foehn/tests/", "packages/acf/tests/"],
            "Studiometa\\FoehnInstaller\\Tests\\": "packages/installer/tests/",
            "Studiometa\\Foehn\\Smoke\\": "packages/starter/tests/smoke/"
        }
    },
    "scripts": {
        "test": [
            "@test:foehn",
            "@test:acf",
            "@test:starter",
            "@test:demo",
            "@test:installer"
        ],
        "test:foehn": "pest --configuration=packages/foehn/phpunit.xml --test-directory=packages/foehn/tests",
        "test:acf": "pest --configuration=packages/acf/phpunit.xml --test-directory=packages/acf/tests",
        "test:starter": "pest --configuration=packages/starter/phpunit.xml --test-directory=packages/starter/tests/php",
        "test:demo": "pest --configuration=packages/demo/phpunit.xml --test-directory=packages/demo/tests/php",
        "test:installer": "pest --configuration=packages/installer/phpunit.xml --test-directory=packages/installer/tests",
        "test:smoke": "pest --configuration=packages/starter/phpunit.smoke.xml --test-directory=packages/starter/tests/smoke",
        "test:coverage": "pest --configuration=packages/foehn/phpunit.xml --test-directory=packages/foehn/tests --coverage --coverage-clover=coverage/clover.xml",
        "test:coverage:installer": "pest --configuration=packages/installer/phpunit.xml --test-directory=packages/installer/tests --coverage --coverage-clover=coverage/clover-installer.xml",
        "test:coverage:acf": "pest --configuration=packages/acf/phpunit.xml --test-directory=packages/acf/tests --coverage --coverage-clover=coverage/clover-acf.xml",
        "analyse": "mago analyse",
        "lint": "mago lint && mago fmt --check",
        "fix": "mago lint --fix && mago fmt"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "studiometa/foehn-installer": true,
            "carthage-software/mago": true,
            "studiometa/ui": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
