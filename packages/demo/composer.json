{
    "name": "studiometa/foehn-demo",
    "description": "Demo project for Foehn — every feature the framework ships, in a working WordPress theme.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Studio Meta",
            "email": "agence@studiometa.fr",
            "homepage": "https://www.studiometa.fr"
        }
    ],
    "keywords": [
        "wordpress",
        "theme",
        "demo",
        "foehn",
        "tempest"
    ],
    "require": {
        "php": "^8.5",
        "composer/installers": "^2.0",
        "humanmade/s3-uploads": "^3.0",
        "johnpbloch/wordpress": "^7.0",
        "studiometa/ui": "^1.10",
        "studiometa/foehn": "^0.5",
        "studiometa/foehn-installer": "^0.5"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Demo\\": "theme/app/"
        }
    },
    "extra": {
        "foehn": {
            "theme-name": "demo-theme"
        },
        "wordpress-install-dir": "web/wp",
        "installer-paths": {
            "web/wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "web/wp-content/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "studiometa/foehn-installer": true,
            "johnpbloch/wordpress-core-installer": true,
            "composer/installers": true,
            "studiometa/ui": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"copy('.env.example', '.env');\""
        ]
    }
}
