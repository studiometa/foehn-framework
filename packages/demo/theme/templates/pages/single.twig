{% extends 'layouts/base.twig' %}

{% block content %}
  {# Anything that is not a project: a journal entry, mostly. #}
  <article>
    <header class="shell masthead">
      <p class="label label--ink index-number">{{ post.date('d.m.Y') }}</p>
      <h1 class="title" style="margin-top: 0.75rem">{{ post.title }}</h1>

      {% if post.post_excerpt %}
        <p class="lead" style="margin-top: clamp(1rem, 3vw, 2rem)">{{ post.post_excerpt }}</p>
      {% endif %}
    </header>

    {% if post.thumbnail %}
      <div class="shell">
        {% include 'components/photograph.twig' with { image: post.thumbnail, loading: 'eager', sizes: '100vw' } %}
      </div>
    {% endif %}

    <div class="shell prose" style="margin-top: clamp(2rem, 6vw, 4rem)">
      {{ post.content }}
    </div>
  </article>
{% endblock %}
