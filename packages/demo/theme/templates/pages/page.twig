{% extends 'layouts/base.twig' %}

{% block content %}
  <article>
    <header class="shell masthead">
      <h1 class="title">{{ post.title }}</h1>

      {% if post.post_excerpt %}
        <p class="lead" style="margin-top: clamp(1rem, 3vw, 2rem)">{{ post.post_excerpt }}</p>
      {% endif %}
    </header>

    <div class="shell grid">
      {% if post.thumbnail %}
        <div class="col-5">
          {% include 'components/photograph.twig' with {
            image: post.thumbnail,
            loading: 'eager',
            sizes: '(min-width: 48rem) 40vw, 100vw'
          } %}
        </div>
      {% endif %}

      <div class="prose {{ post.thumbnail ? 'at-7-6' : 'col-8' }}">
        {{ post.content }}
      </div>
    </div>

    {% set faq = post.meta('faq') %}

    {#
      studiometa/ui's Accordion, reached through the @ui namespace the framework
      registers when the package is installed. The template emits
      data-component="Accordion", and `import '@studiometa/ui/autoload'` in app.js
      is what makes the browser fetch and mount the class behind that name — no
      import of the component here, and no import of it in the JavaScript either.
    #}
    {% if faq %}
      <section class="shell" style="margin-top: clamp(3rem, 8vw, 6rem)" aria-labelledby="faq">
        <h2 class="label label--ink" id="faq">Questions</h2>
        <hr class="rule rule--ink" style="margin-top: 0.75rem" />

        {% embed '@ui/Accordion/Accordion.twig' with {
          items: faq,
          attr: { class: 'faq' },
          item_attr: { class: 'faq__item' }
        } %}
          {% block title %}
            <span class="faq__question">{{ item.title }}</span>
            <span class="faq__marker" aria-hidden="true"></span>
          {% endblock %}

          {% block content %}
            <div class="faq__answer prose">{{ item.content }}</div>
          {% endblock %}
        {% endembed %}
      </section>
    {% endif %}
  </article>
{% endblock %}
