{% extends 'layouts/base.twig' %}

{% block content %}
  {% set current_type = query_get('post_type') %}

  <section class="shell masthead">
    <p class="label label--ink">Search</p>
    <h1 class="title" style="margin-top: 0.75rem">« {{ search_query }} »</h1>
    <p class="label" style="margin-top: 1.5rem">
      {{ found_posts|plural('result') }}
    </p>

    <div style="margin-top: 1.5rem">
      {% include 'components/search-form.twig' with {
        id: 'search-again',
        label: 'Search again',
        value: search_query,
        keep_query: true
      } %}
    </div>

    {#
      The post type facet. The groups count each searchable post type with the other
      filters of the URL applied, also when the page shows one type only. Narrow to one
      type with query_url(), widen again with query_url_without().
    #}
    <p class="label search-facet" style="margin-top: 1rem">
      {% for group in groups %}
        {% if current_type == group.post_type %}
          <span aria-current="true">{{ group.label }} ({{ group.count }})</span>
        {% else %}
          <a href="{{ query_url({ post_type: group.post_type }) }}">{{ group.label }} ({{ group.count }})</a>
        {% endif %}
        /
      {% endfor %}
      {% if current_type %}
        <a href="{{ query_url_without('post_type') }}">All types</a>
      {% else %}
        <span aria-current="true">All types</span>
      {% endif %}
    </p>
  </section>

  {% if current_type or not groups %}
    <section class="shell">
      {% for post in posts %}
        {% include 'components/search-result.twig' %}
      {% else %}
        <p>No results.</p>
      {% endfor %}

      {% if pagination %}
        {% include 'components/pagination.twig' %}
      {% endif %}
    </section>
  {% else %}
    {# Each post type with its best results, the most relevant type first. #}
    {% for group in groups %}
      <section
        class="shell search-group"
        id="search-group-{{ group.post_type }}"
        aria-labelledby="search-group-{{ group.post_type }}-title">
        <h2 class="label label--ink search-group__title" id="search-group-{{ group.post_type }}-title">
          {{ group.label }} ({{ group.count }})
        </h2>
        {% for post in group.posts %}
          {% include 'components/search-result.twig' %}
        {% endfor %}
        <a class="label label--ink search-group__all" href="{{ group.url }}">
          See all {{ group.label|lower }}
        </a>
      </section>
    {% endfor %}
  {% endif %}
{% endblock %}
