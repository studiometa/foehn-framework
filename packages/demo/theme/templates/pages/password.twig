{% extends 'layouts/base.twig' %}

{#
  Password-protected content, rendered by SingleController and PageController
  while `post_password_required()` is true.

  The form is WordPress's own: it posts to `wp-login.php?action=postpass`, which
  sets the cookie and sends the visitor back here. Neither `post.content` nor
  `post.excerpt`: Timber prints both in full, password or not, unless the
  `timber/post/content/show_password_form_for_protected` filter asks for the form
  in their place.
#}
{% block content %}
  <article>
    <header class="shell masthead">
      <h1 class="title">{{ post.title }}</h1>
    </header>

    <div class="shell grid">
      <div class="prose col-8">
        {{ function('get_the_password_form', post.ID) }}
      </div>
    </div>
  </article>
{% endblock %}
