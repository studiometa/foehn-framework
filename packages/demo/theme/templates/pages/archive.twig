{% extends 'layouts/base.twig' %}

{% block content %}
  {# The fallback index: categories, tags, taxonomies, and any post type without a
     template of its own. Same row as the projects index, without the facts. #}
  <section class="shell masthead">
    <p class="label label--ink">Index</p>
    <h1 class="title" style="margin-top: 0.75rem">{{ archive_title|striptags|trim }}</h1>

    {% if archive_description %}
      <div class="lead" style="margin-top: clamp(1rem, 3vw, 2rem)">
        {{ archive_description|striptags|trim }}
      </div>
    {% endif %}
  </section>

  <section class="shell">
    {% for post in posts %}
      <a class="index-row" href="{{ post.link }}">
        <span class="label index-number">{{ '%02d'|format(loop.index) }}</span>
        <span><span class="index-row__title">{{ post.title }}</span></span>
        <span class="index-row__aside label index-number">{{ post.date('Y') }}</span>
      </a>
    {% else %}
      <p>Nothing to show here.</p>
    {% endfor %}

    {% if pagination %}
      {% include 'components/pagination.twig' %}
    {% endif %}
  </section>
{% endblock %}
