{% extends 'layouts/base.twig' %}

{% block content %}
  {#
    The index is a table that behaves like a poster: number flush left, title at
    display size, year and place flush right. No thumbnails — the point of the page
    is the shape of the body of work, not a preview of it.
  #}
  <section class="shell masthead">
    <p class="label label--ink">Index</p>
    <h1 class="title" style="margin-top: 0.75rem">Projects</h1>

    <div class="masthead__meta">
      {# A section, so the count is swapped with the results rather than left stale. #}
      {{ foehn_section('project-count', { posts }) }}
      {% if archive_description %}
        <div class="label">{{ archive_description|striptags|trim }}</div>
      {% endif %}
    </div>
  </section>

  {#
    Three sections, because a filter changes three parts of this page and they are not
    next to each other: the count up in the masthead, the form, and the results. One
    request renders all three — `?foehn_sections=project-count,project-filters,project-index`
    — and the form is in there because its facet counts, its dead-end options and its
    Reset link are all answers to the current URL that only the server can give.

    The form declares no context: nothing it renders comes from this template, only from
    the query. See `sections/project-filters.twig` for why the swap uses `morph`.
  #}
  {{ foehn_section('project-filters') }}

  {{ foehn_section('project-index', { posts, pagination }) }}
{% endblock %}
