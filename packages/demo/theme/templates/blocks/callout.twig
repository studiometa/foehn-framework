{# html_classes() and html_styles() from twig-toolkit build the attributes from data. #}
<div
  class="{{ html_classes(['callout', 'callout--' ~ tone, { 'callout--dismissible': dismissible }]) }}"
  {{
  html_attributes({
    data_dismissible: dismissible
  })
  }}>
  {% if icon %}
    <img class="callout__icon" src="{{ icon.src }}" alt="{{ icon.alt }}" width="48" height="48" />
  {% endif %}

  <div class="callout__content">
    {% if title %}
      <p class="callout__title">
        {{ title }}
      </p>
    {% endif %}

    {% if body %}
      <p class="callout__body" {{ html_attributes({ style: columns > 1 ? html_styles({ column_count: columns }) : null }) }}>
        {{ body }}
      </p>
    {% endif %}
  </div>

  {% if dismissible %}
    <button class="callout__dismiss" type="button" aria-label="Dismiss">&times;</button>
  {% endif %}
</div>
