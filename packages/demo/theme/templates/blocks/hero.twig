<section
  class="hero hero--{{ height }}"
  {{
  html_attributes({
    id: anchor ?? null
  })
  }}>
  {% if background %}
    <img
      class="hero__background"
      src="{{ background.src }}"
      alt="{{ background.alt }}"
      {{
      html_attributes({
        width: background.width ?? null,
        height: background.height ?? null
      })
      }} />
  {% endif %}

  <div class="hero__content">
    <h1 class="hero__title">{{ title }}</h1>

    {% if subtitle %}
      <p class="hero__subtitle">
        {{ subtitle }}
      </p>
    {% endif %}

    {% if cta %}
      <a
        class="hero__cta"
        href="{{ cta.url }}"
        {{
        html_attributes({
          target: cta.target ?? null
        })
        }}>
        {{ cta.title }}
      </a>
    {% endif %}
  </div>
</section>
