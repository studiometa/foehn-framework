<section class="shell" style="margin-top: clamp(4rem, 10vw, 8rem)" aria-labelledby="retours">
  <h2 class="label label--ink" id="retours">Words</h2>
  <hr class="rule rule--ink" style="margin-top: 0.75rem" />

  <div class="grid" style="margin-top: clamp(1.5rem, 4vw, 2.5rem)">
    {% for testimonial in testimonials %}
      <div class="col-4">
        <blockquote class="quote">
          <p class="quote__text">
            {{ testimonial.content|striptags|trim }}
          </p>
          <footer class="quote__source label">
            {{- testimonial.authorName -}}
            {%- if testimonial.authorRole %}, {{ testimonial.authorRole }}{% endif -%}
            {%- if testimonial.company %} — {{ testimonial.company }}{% endif -%}
          </footer>
          {% if testimonial.rating is not null %}
            {% set max = constant('Demo\\Models\\Testimonial::MAX_RATING') %}
            <p class="quote__rating label" aria-label="Rated {{ testimonial.rating }} out of {{ max }}">
              {%- for star in 1..max -%}{{ star <= testimonial.rating ? '★' : '☆' }}{%- endfor -%}
            </p>
          {% endif %}
        </blockquote>
      </div>
    {% endfor %}
  </div>
</section>
