{% if pagination %}
  <nav class="pagination" aria-label="Pagination">
    {% if pagination.prev %}
      <a
        href="{{ pagination.prev.link }}"
        class="pagination__prev"
        aria-label="Previous page"
        {% if pagination_section is defined %}
          data-component="Fetch"
          data-option-src="{{ foehn_section_url(pagination_section, pagination.prev.link) }}"
        {% endif %}>
        &larr; Previous
      </a>
    {% endif %}

    <ul class="pagination__pages">
      {% for page in pagination.pages %}
        <li>
          {% if page.current %}
            <span class="pagination__page pagination__page--current" aria-current="page">
              {{ page.title }}
            </span>
          {% else %}
            <a
              href="{{ page.link }}"
              class="pagination__page"
              {% if pagination_section is defined %}
                data-component="Fetch"
                data-option-src="{{ foehn_section_url(pagination_section, page.link) }}"
              {% endif %}>{{ page.title }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>

    {% if pagination.next %}
      <a
        href="{{ pagination.next.link }}"
        class="pagination__next"
        aria-label="Next page"
        {% if pagination_section is defined %}
          data-component="Fetch"
          data-option-src="{{ foehn_section_url(pagination_section, pagination.next.link) }}"
        {% endif %}>
        Next &rarr;
      </a>
    {% endif %}
  </nav>
{% endif %}
