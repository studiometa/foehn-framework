<header class="site-header">
  <a href="{{ site.url }}" class="site-header__logo" rel="home">{{ site.name }}</a>

  {% if menus.header %}
    <nav class="site-header__nav" aria-label="Primary navigation">
      <ul>
        {% for item in menus.header.items %}
          <li class="{{ item.classes|join(' ') }}">
            <a
              href="{{ item.link }}"
              {% if item.current %}aria-current="page"{% endif %}
              {{
              html_attributes(
                item.is_external
                  ? {
                    target: '_blank',
                    rel: 'noopener'
                  }
                  : {}
              )
              }}>
              {{ item.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}

  {# languages() is empty without Polylang. A page without a translation links to the home page of the language. #}
  {% set languages = languages() %}
  {% if languages %}
    <nav class="site-header__languages" aria-label="Languages">
      <ul>
        {% for language in languages %}
          <li>
            <a
              href="{{ language.url }}"
              hreflang="{{ language.code }}"
              lang="{{ language.code }}"
              {% if language.current %}aria-current="true"{% endif %}>
              {{ language.code|upper }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}
</header>
