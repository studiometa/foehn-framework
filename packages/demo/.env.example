# Database
DB_NAME=db
DB_USER=db
DB_PASSWORD=db
DB_HOST=db
DB_PREFIX=wp_

# URLs
WP_HOME=https://foehn-demo.ddev.site
WP_SITEURL=${WP_HOME}/wp

# Environment: local, development, staging, production
WP_ENVIRONMENT_TYPE=local

# Debug
WP_DEBUG=true

# Post revisions
WP_POST_REVISIONS=5

# Object storage for uploads
#
# The demo offloads its uploads to the MinIO service in .ddev/docker-compose.minio.yaml,
# because a generated web root makes everything except wp-content/uploads/ disposable,
# and a deploy target with no persistent disk needs somewhere else to put them.
#
# wp-config.php defines the S3_UPLOADS_* constants humanmade/s3-uploads reads only when
# S3_UPLOADS_BUCKET is set. Comment it out and uploads go back to local disk.
#
# ENDPOINT is the API, on the project network. BUCKET_URL is what a browser loads.
S3_UPLOADS_BUCKET=media
S3_UPLOADS_REGION=us-east-1
S3_UPLOADS_ENDPOINT=http://minio:9000
S3_UPLOADS_BUCKET_URL=https://foehn-demo.ddev.site:9443/media
S3_UPLOADS_PATH_STYLE=true

# MinIO rejects the integrity headers AWS SDK 3.337 made the default, which shows up as
# uploads failing with nothing mentioning checksums. AWS itself needs these left on.
S3_UPLOADS_CHECKSUMS=false

AWS_ACCESS_KEY_ID=foehn
AWS_SECRET_ACCESS_KEY=foehn-demo-secret

# WordPress security keys
#
# Left empty on purpose. `composer install` fills them in with random values, or run
# `wp foehn salts:generate`. Supply them however you prefer instead — container
# variables, a vault — and the installer leaves them alone.
#
# wp-config.php refuses to serve a production request while they are empty: keys that
# can be guessed are keys that can forge a login.
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=
