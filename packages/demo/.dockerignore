# What must never reach the build context.
#
# Everything listed here is either produced by the build itself — and a copy from
# the host would be produced by a different toolchain, on a different platform,
# from a different lockfile — or specific to one developer's machine.
#
# `vendor/` and `web/` are the sharpest of the two. `web/` is generated by
# `studiometa/foehn-installer` during `composer install`, and the symlinks in it
# point at absolute paths on the host; a host copy landing in the image would
# shadow the one the vendor stage just built, with links that resolve to nothing.

node_modules
vendor
web
theme/dist
dist

# The host's `composer.lock` is not committed for this package on purpose: the
# demo tracks `studiometa/foehn: ^0.5` and the deployed site is meant to show the
# last release. A lockfile from a developer's machine would pin it to whatever
# they happened to have.
composer.lock

# ddev's own directory is a per-machine, per-project-name artifact: certificates,
# a router configuration and a MinIO service that has no counterpart on Fly.
.ddev

# The image reads its configuration from the environment and nothing else — the
# runtime image sets `variables_order = "EGPCS"` precisely so no `.env` has to be
# written into it. One arriving from the host would carry the ddev database host,
# the ddev URL and a set of security keys, and `Dotenv` fills in every variable
# the container did not already define: a site pointing at `minio:9000` and
# redirecting to `foehn-demo.ddev.site`.
.env

# Test material and caches. Neither is served, and `.git` alone is larger than
# everything the image needs.
tests
.git
.stylelintcache
