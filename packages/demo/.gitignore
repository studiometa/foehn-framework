# Dependencies
/vendor/
/node_modules/
composer.lock

# Generated web root
/web/

# Build output — vite now writes into the theme, which is what gets symlinked
# into the web root; only files under theme/ are ever served.
/dist/
/theme/dist/
.stylelintcache

# Tests — result caches written by Pest when test suites run
/.phpunit.cache/
/.phpunit.smoke.cache/

# Environment
.env

# Generated secrets — .env holds the keys by default; this file is the alternative
/config/wordpress-salts.config.php

# DDEV
#
# Everything under .ddev/ is generated except the configuration: certificates,
# router config, per-service overrides and image build context, all stamped
# #ddev-generated and all specific to one machine and one project name. An
# allowlist rather than a list of what ddev happens to write today — a stale
# router config for a project that has been renamed is not an obvious thing to
# debug from a CI log.
/.ddev/*
!/.ddev/config.yaml
!/.ddev/config.local.example.yaml
!/.ddev/docker-compose.minio.yaml
!/.ddev/nginx/
!/.ddev/nginx/*.conf
# nginx_full is mounted as sites-enabled, which is nginx's `http` context. The
# rate limit's zone has to be declared there; the rule that uses it lives in
# nginx/. Only our file is kept — nginx-site.conf beside it is ddev-generated.
!/.ddev/nginx_full/
!/.ddev/nginx_full/00-foehn-image-limit.conf
# Written and removed by smoke tests; left behind on aborted runs.
# Smoke tests generate this nginx include for testing, then delete it when done.
/.ddev/nginx/foehn-page-cache.conf

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
