{
  "name": "@studiometa/foehn-vite-plugin",
  "version": "0.5.3",
  "description": "Vite plugin for Føhn WordPress framework",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "fmt": "oxfmt --write src tests",
    "fmt:check": "oxfmt --check src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "wordpress",
    "foehn"
  ],
  "author": "Studio Meta <agence@studiometa.fr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiometa/foehn-framework.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/studiometa/foehn-framework/issues"
  },
  "homepage": "https://github.com/studiometa/foehn-framework/tree/main/packages/vite-plugin#readme",
  "dependencies": {
    "fast-glob": "^3.3.0"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.0.0",
    "@typescript/typescript6": "^6.0.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
