# Database
DB_NAME=db
DB_USER=db
DB_PASSWORD=db
DB_HOST=db
DB_PREFIX=wp_

# URLs
WP_HOME=https://foehn-starter.ddev.site
WP_SITEURL=${WP_HOME}/wp

# Environment: local, development, staging, production
WP_ENVIRONMENT_TYPE=local

# Debug
WP_DEBUG=true

# Post revisions
WP_POST_REVISIONS=5

# WordPress security keys
#
# Left empty on purpose. `composer install` fills them in with random values, or run
# `wp foehn salts:generate`. Supply them however you prefer instead — container
# variables, a vault — and the installer leaves them alone.
#
# wp-config.php refuses to serve a production request while they are empty: keys that
# can be guessed are keys that can forge a login.
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# Object storage for uploads
#
# web/ is generated and wp/ comes from Composer, so a deploy can throw the whole
# document root away and rebuild it — except web/wp-content/uploads/, which is the one
# directory holding something neither the repository nor Composer can reproduce. On a
# container with no persistent disk it does not survive a release.
#
#     composer require humanmade/s3-uploads
#     wp plugin activate s3-uploads
#
# Uncomment below and wp-config.php defines the constants it reads. Leave it commented
# and nothing is defined at all: uploads stay on local disk, installed plugin or not.
#
# See docs/guide/uploads.md.
#
# S3_UPLOADS_BUCKET=
# S3_UPLOADS_REGION=
# S3_UPLOADS_BUCKET_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Anything that is not AWS — R2, Scaleway, MinIO — needs an endpoint as well, which
# comes from opting into S3UploadsEndpoint in app/foehn.config.php.
#
# S3_UPLOADS_ENDPOINT=
# S3_UPLOADS_PATH_STYLE=true
# S3_UPLOADS_CHECKSUMS=false
