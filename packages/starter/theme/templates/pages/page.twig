{% extends 'layouts/base.twig' %}

{% block content %}
  <article class="page" id="page-{{ post.ID }}">
    <header class="page__header">
      <h1 class="page__title">{{ post.title }}</h1>
    </header>

    <div class="page__content">
      {{ post.content }}
    </div>
  </article>
{% endblock %}
