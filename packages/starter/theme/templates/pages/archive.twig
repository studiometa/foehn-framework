{% extends 'layouts/base.twig' %}

{% block content %}
  <div class="archive">
    <header class="archive__header container">
      <h1 class="archive__title">{{ archive_title }}</h1>

      {% if archive_description %}
        <div class="archive__description">
          {{ archive_description }}
        </div>
      {% endif %}
    </header>

    <div class="archive__posts container">
      {# Declared as a section, so `?foehn_sections=posts` returns this list alone. #}
      {{ foehn_section('posts', { posts, pagination }) }}
    </div>
  </div>
{% endblock %}
