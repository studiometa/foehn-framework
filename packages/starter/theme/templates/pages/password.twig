{% extends 'layouts/base.twig' %}

{#
  Contenu protégé par mot de passe, rendu par SingleController et PageController
  tant que `post_password_required()` est vrai.

  Le formulaire est celui de WordPress : il poste vers
  `wp-login.php?action=postpass`, qui pose le cookie et renvoie ici. Ni
  `post.content` ni `post.excerpt` : Timber les affiche en entier, mot de passe
  ou non, tant que le filtre `timber/post/content/show_password_form_for_protected`
  ne demande pas le formulaire à leur place.
#}
{% block content %}
  <article class="page page--password" id="post-{{ post.ID }}">
    <header class="page__header">
      <h1 class="page__title">{{ post.title }}</h1>
    </header>

    <div class="page__content">
      {{ function('get_the_password_form', post.ID) }}
    </div>
  </article>
{% endblock %}
