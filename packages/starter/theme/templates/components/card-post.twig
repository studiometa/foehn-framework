<article class="card-post">
  {% if post.thumbnail %}
    <figure class="card-post__thumbnail">
      <a href="{{ post.link }}">
        <img
          src="{{ post.thumbnail.src('card') }}"
          alt="{{ post.thumbnail.alt }}"
          loading="lazy"
          width="400"
          height="300" />
      </a>
    </figure>
  {% endif %}

  <div class="card-post__content">
    <h3 class="card-post__title"><a href="{{ post.link }}">{{ post.title }}</a></h3>

    <time class="card-post__date" datetime="{{ post.date('c') }}">{{ post.date('j F Y') }}</time>

    {#
      Timber construit l'extrait à partir du contenu sans tenir compte du mot de
      passe : sans ce test, la liste affiche le début d'un article protégé.
    #}
    {% if not post.password_required and post.excerpt %}
      <p class="card-post__excerpt">
        {{ post.excerpt }}
      </p>
    {% endif %}
  </div>
</article>
