{
    "name": "studiometa/foehn-starter",
    "description": "Starter theme for Foehn — a modern WordPress framework powered by Tempest.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Studio Meta",
            "email": "agence@studiometa.fr",
            "homepage": "https://www.studiometa.fr"
        }
    ],
    "keywords": [
        "wordpress",
        "theme",
        "starter",
        "foehn",
        "tempest"
    ],
    "require": {
        "php": "^8.5",
        "composer/installers": "^2.0",
        "johnpbloch/wordpress": "^7.0",
        "studiometa/ui": "^1.10",
        "studiometa/foehn": "0.6.1",
        "studiometa/foehn-installer": "0.6.1"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "theme/app/"
        }
    },
    "extra": {
        "foehn": {
            "theme-name": "starter-theme"
        },
        "wordpress-install-dir": "web/wp",
        "installer-paths": {
            "web/wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "web/wp-content/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "studiometa/foehn-installer": true,
            "johnpbloch/wordpress-core-installer": true,
            "composer/installers": true,
            "studiometa/ui": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "pestphp/pest": "^5.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Studiometa\\Foehn\\Smoke\\": "tests/smoke/"
        }
    },
    "scripts": {
        "test": "pest --configuration=phpunit.xml --test-directory=tests/php",
        "test:smoke": "pest --configuration=phpunit.smoke.xml --test-directory=tests/smoke"
    }
}
