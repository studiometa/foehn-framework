<?xml version="1.0" encoding="UTF-8"?>
<!--
    The smoke test of the project: real requests to the site in a started ddev project.
    It is not part of `composer test`, which runs without a site. Run it with
    `composer test:smoke`.

    The bootstrap is the Composer autoloader only, not tests/php/bootstrap.php: that file
    loads WordPress function stubs, and this suite asks the real site.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.smoke.cache"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Smoke">
            <directory>tests/smoke</directory>
        </testsuite>
    </testsuites>
</phpunit>
