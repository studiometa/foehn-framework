<?xml version="1.0" encoding="UTF-8"?>
<!--
    The framework's end-to-end suite, run against the starter in ddev. Needs a running
    ddev project, so it is not part of `composer test` — CI runs that on a bare runner.
    Run it with `composer test:smoke` from the monorepo root.

    This directory is export-ignored: projects created from the starter do not get it.
    Their own smoke test is tests/smoke/ in the starter.

    The bootstrap is bootstrap.php beside this file, not tests/php/bootstrap.php: the
    latter loads WordPress function stubs, and a stub in scope here would let a test
    believe it had asked the site something when it had not.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="true"
         cacheDirectory="../../.phpunit.smoke.cache"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Framework smoke">
            <directory>.</directory>
        </testsuite>
    </testsuites>
</phpunit>
