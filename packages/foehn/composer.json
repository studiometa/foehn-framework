{
    "name": "studiometa/foehn",
    "description": "🍃 A modern WordPress framework powered by Tempest, featuring attribute-based auto-discovery for hooks, post types, blocks, and more.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Studio Meta",
            "email": "agence@studiometa.fr",
            "homepage": "https://www.studiometa.fr"
        }
    ],
    "keywords": [
        "wordpress",
        "framework",
        "tempest",
        "timber",
        "gutenberg",
        "blocks",
        "fse",
        "attributes",
        "discovery"
    ],
    "homepage": "https://github.com/studiometa/foehn-framework",
    "support": {
        "issues": "https://github.com/studiometa/foehn-framework/issues",
        "source": "https://github.com/studiometa/foehn-framework"
    },
    "require": {
        "php": "^8.5",
        "studiometa/twig-toolkit": "^2.1",
        "tempest/container": "^3.18",
        "tempest/discovery": "^3.18",
        "tempest/generation": "^3.18",
        "tempest/support": "^3.18",
        "timber/timber": "^2.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Lets GlideTransformer read and cache in the same bucket as humanmade/s3-uploads",
        "league/glide": "Self-hosted image transforms for GlideTransformer (with league/flysystem-aws-s3-v3 when uploads live in a bucket)",
        "studiometa/ui": "Twig UI components, auto-registered under the @ui and @svg namespaces",
        "studiometa/webpack-config": "Required for WebpackManifest asset helper"
    },
    "autoload": {
        "psr-4": {
            "Studiometa\\Foehn\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Studiometa\\Foehn\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/glide": "^4.1",
        "studiometa/ui": "^1.10"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "studiometa/ui": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
